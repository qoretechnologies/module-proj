# Valgrind suppressions for known false positives from optimized libqore
# and libproj builds. These are uninitialized value reads caused by compiler
# optimizations in release builds - not actual bugs.

# --- libqore false positives (optimized build) ---

{
   qore-value-set-uninit
   Memcheck:Cond
   fun:*QoreValue*set*
}

{
   qore-value-gettype-uninit
   Memcheck:Cond
   fun:*QoreValue*getType*
}

{
   qore-value-assign-uninit
   Memcheck:Cond
   fun:*QoreValue*assign*
}

{
   qore-value-deref-uninit
   Memcheck:Cond
   fun:*QoreValue*deref*
}

{
   qore-value-discard-uninit
   Memcheck:Cond
   fun:*QoreValue*discard*
}

{
   qore-value-isnothing-uninit
   Memcheck:Cond
   fun:*QoreValue*isNothing*
}

{
   qore-value-isnull-uninit
   Memcheck:Cond
   fun:*QoreValue*isNull*
}

{
   qore-parser-yyparse-uninit
   Memcheck:Cond
   fun:*yyparse*
}

{
   qore-parser-process-assignment-uninit
   Memcheck:Cond
   fun:*process_assignment*
}

{
   qore-parser-splice-expressions-uninit
   Memcheck:Cond
   fun:*splice_expressions*
}

{
   qore-init-math-uninit
   Memcheck:Cond
   ...
   fun:*init_math_constants*
}

{
   qore-static-system-ns-uninit
   Memcheck:Cond
   ...
   fun:*StaticSystemNamespace*
}

{
   qore-constant-clear-uninit
   Memcheck:Cond
   ...
   fun:*ConstantList*clear*
}

{
   qore-qorevalue-cond-generic
   Memcheck:Cond
   obj:*/libqore.so*
}

{
   qore-qorevalue-value-generic
   Memcheck:Value8
   obj:*/libqore.so*
}

# --- libproj false positives ---
#
# libproj (PROJ) loads proj.db via libsqlite3 at context creation and caches
# CRS / datum / grid metadata until process exit. Our module intentionally
# does not call proj_context_destroy() on thread shutdown — see the comment
# in src/proj-module.cpp where tl_proj_ctx is declared — so these allocations
# surface as "definitely / possibly lost" under valgrind. The leaks are
# fixed-size, bounded by the number of worker threads, and released by the
# OS at process exit. Suppress anything terminating in libproj.

{
   proj-ctx-leak-any
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:*pj_ctx*
}

{
   proj-database-context-leak-any
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:*DatabaseContext*create*
}

{
   proj-obj-leak-any
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libproj.so*
}

# --- libsqlite3 false positives (used internally by libproj) ---
#
# PROJ uses SQLite to read proj.db and keeps prepared-statement / connection
# state in thread-local memory. libsqlite3 allocations that are reachable
# only from libproj's internal handles show up as leaks; suppress anything
# terminating in libsqlite3.

{
   proj-sqlite-leak-any
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libsqlite3.so*
}

{
   proj-sqlite-fn-leak-any
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:sqlite3_*
}
